{
  "name": "vackle",
  "version": "0.4.0",
  "private": true,
  "description": "Flackle client mod",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node scripts/build/build.mjs",
    "buildWeb": "node scripts/build/buildWeb.mjs",
    "watch": "pnpm build --watch",
    "watchWeb": "pnpm buildWeb --watch",
    "inject": "node scripts/runInstaller.mjs install",
    "uninject": "node scripts/runInstaller.mjs uninstall",
    "test": "pnpm testTsc && esbuild \"tests/*.test.ts\" --bundle --outdir=.test-build --platform=node --format=esm --target=node22 --packages=external --loader:.png=dataurl --loader:.css=text --log-level=warning && node --test \".test-build/*.test.js\"",
    "testTsc": "tsc --noEmit"
  },
  "engines": {
    "node": ">=25.5"
  },
  "packageManager": "pnpm@11.25.0",
  "vackle": {
    "repository": "sinincali/vackle",
    "publicKey": "MCowBQYDK2VwAyEA8YaQeQFZZZne+H4lH4qWWUmRxxcljkrZmQQJ18GtxoA="
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.1",
    "typescript": "7.0.2"
  }
}
